FROM public.ecr.aws/docker/library/node:24-bookworm-slim AS builder
WORKDIR /app
COPY quantforge-ui/package.json quantforge-ui/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY quantforge-ui/index.html quantforge-ui/tsconfig*.json quantforge-ui/vite.config.ts ./
COPY quantforge-ui/src ./src
COPY quantforge-ui/public ./public
ENV VITE_QF_BINDINGS_API=/gateway
RUN npm run build

FROM public.ecr.aws/docker/library/nginx:stable-alpine
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 8080
